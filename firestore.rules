rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function myDoc() { return userDoc(request.auth.uid); }
    function projectDoc(pid) { return /databases/$(database)/documents/projects/$(pid); }
    function eventDoc(pid, eid) { return /databases/$(database)/documents/projects/$(pid)/events/$(eid); }
    function signed() { return request.auth != null; }
    function member() {
      return signed() && exists(myDoc()) && get(myDoc()).data.active == true
        && get(myDoc()).data.role in ['collaborator', 'area_manager', 'manager'];
    }
    function manager() { return member() && get(myDoc()).data.role in ['area_manager', 'manager']; }
    function areaManagerRole() { return manager(); }
    function areaManager() { return manager(); }
    function myName() { return get(myDoc()).data.name; }
    function validPerson(uid, role) {
      return uid is string && exists(userDoc(uid)) && get(userDoc(uid)).data.active == true
        && get(userDoc(uid)).data.role == role;
    }
    function validManager(uid) {
      return uid is string && exists(userDoc(uid)) && get(userDoc(uid)).data.active == true
        && get(userDoc(uid)).data.role in ['area_manager', 'manager'];
    }
    function linkedEvent(pid, eid, kind) {
      return existsAfter(eventDoc(pid, eid))
        && getAfter(eventDoc(pid, eid)).data.type == kind
        && getAfter(eventDoc(pid, eid)).data.actorId == request.auth.uid
        && getAfter(eventDoc(pid, eid)).data.createdAt == request.time;
    }
    function projectFields() {
      return request.resource.data.keys().hasAll([
        'title', 'description', 'area', 'ownerName', 'authorId', 'authorName',
        'areaManagerId', 'approverIds', 'approvalStates', 'costCents', 'returnCents',
        'returnPeriod', 'estimateNotes', 'status', 'archived', 'nonCompletionReason',
        'createdAt', 'updatedAt', 'lastActionId'
      ]) && request.resource.data.keys().hasOnly([
        'title', 'description', 'area', 'ownerName', 'authorId', 'authorName',
        'areaManagerId', 'approverIds', 'approvalStates', 'costCents', 'returnCents',
        'returnPeriod', 'estimateNotes', 'status', 'archived', 'nonCompletionReason',
        'createdAt', 'updatedAt', 'lastActionId'
      ]);
    }
    function validProposal() {
      return request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 4000
        && request.resource.data.area is string && request.resource.data.area.size() > 0
        && request.resource.data.area.size() <= 120
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() > 0
        && request.resource.data.ownerName.size() <= 120
        && request.resource.data.estimateNotes is string && request.resource.data.estimateNotes.size() > 0
        && request.resource.data.estimateNotes.size() <= 2000
        && request.resource.data.costCents is int && request.resource.data.costCents > 0
        && request.resource.data.costCents <= 1000000000000
        && request.resource.data.returnCents is int && request.resource.data.returnCents >= 0
        && request.resource.data.returnCents <= 1000000000000
        && request.resource.data.returnPeriod in ['month', 'year'];
    }
    function validAreaManager() {
      return validManager(request.resource.data.areaManagerId)
        && get(userDoc(request.resource.data.areaManagerId)).data.department == request.resource.data.area;
    }
    function validApproverAt(index) {
      return request.resource.data.approverIds.size() <= index
        || validManager(request.resource.data.approverIds[index]);
    }
    function validApprovers() {
      return request.resource.data.approverIds is list
        && request.resource.data.approverIds.size() >= 2
        && request.resource.data.approverIds.size() <= 5
        && request.resource.data.approverIds.toSet().size() == request.resource.data.approverIds.size()
        && validApproverAt(0) && validApproverAt(1) && validApproverAt(2)
        && validApproverAt(3) && validApproverAt(4)
        && request.resource.data.approvalStates is map
        && request.resource.data.approvalStates.keys().toSet() == request.resource.data.approverIds.toSet()
        && request.resource.data.approvalStates.values().hasOnly(['pending']);
    }
    function allApproved() {
      return request.resource.data.approvalStates.values().hasOnly(['approved']);
    }
    function validReason() {
      return request.resource.data.nonCompletionReason is string
        && ((request.resource.data.status == 'not_completed'
          && request.resource.data.nonCompletionReason.size() > 0
          && request.resource.data.nonCompletionReason.size() <= 2000)
          || (request.resource.data.status != 'not_completed'
          && request.resource.data.nonCompletionReason == ''));
    }
    function standardTransition() {
      return (resource.data.status == 'pending' && request.resource.data.status == 'rejected')
        || (resource.data.status == 'approved' && request.resource.data.status == 'in_progress')
        || (resource.data.status == 'in_progress'
          && request.resource.data.status == 'not_completed');
    }

    match /users/{uid} {
      allow get: if signed() && request.auth.uid == uid;
      // A lista interna permite escolher gestores cadastrados pela TI.
      allow list: if member();
      allow create, update, delete: if false;
    }

    match /projects/{pid} {
      allow get, list: if member() && (resource.data.archived == false || areaManagerRole());
      allow create: if member() && projectFields() && validProposal() && validAreaManager()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == myName()
        && request.resource.data.status == 'pending'
        && request.resource.data.approverIds == []
        && request.resource.data.approvalStates == {}
        && request.resource.data.archived == false
        && request.resource.data.nonCompletionReason == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActionId is string
        && linkedEvent(pid, request.resource.data.lastActionId, 'created');
      allow update: if member() && projectFields()
        && resource.data.archived == false
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActionId is string
        && request.resource.data.lastActionId != resource.data.lastActionId
        && (
          (areaManager()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'approverIds', 'approvalStates', 'updatedAt', 'lastActionId'
            ])
            && resource.data.status == 'pending'
            && request.resource.data.status == 'review'
            && validApprovers()
            && linkedEvent(pid, request.resource.data.lastActionId, 'review_started'))
          ||
          (manager()
            && request.auth.uid in resource.data.approverIds
            && resource.data.status == 'review'
            && resource.data.approvalStates[request.auth.uid] == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'approvalStates', 'updatedAt', 'lastActionId'
            ])
            && request.resource.data.approvalStates.diff(resource.data.approvalStates).affectedKeys()
              .hasOnly([request.auth.uid])
            && request.resource.data.approvalStates[request.auth.uid] == 'approved'
            && ((allApproved() && request.resource.data.status == 'in_progress')
              || (!allApproved() && request.resource.data.status == 'review'))
            && linkedEvent(pid, request.resource.data.lastActionId, 'manager_approved'))
          ||
          (areaManager()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'nonCompletionReason', 'updatedAt', 'lastActionId'
            ])
            && standardTransition() && validReason()
            && linkedEvent(pid, request.resource.data.lastActionId, request.resource.data.status))
          ||
          (member()
            && resource.data.authorId == request.auth.uid
            && resource.data.status == 'in_progress'
            && request.resource.data.status == 'completed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updatedAt', 'lastActionId'
            ])
            && linkedEvent(pid, request.resource.data.lastActionId, 'completed'))
          ||
          (areaManager()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'archived', 'updatedAt', 'lastActionId'
            ])
            && request.resource.data.archived == true
            && linkedEvent(pid, request.resource.data.lastActionId, 'archived'))
        );
      allow delete: if false;

      match /events/{eid} {
        allow get, list: if member()
          && (get(projectDoc(pid)).data.archived == false || areaManagerRole());
        allow create: if member()
          && request.resource.data.keys().hasAll(['type', 'actorId', 'actorName', 'detail', 'createdAt'])
          && request.resource.data.keys().hasOnly(['type', 'actorId', 'actorName', 'detail', 'createdAt'])
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.actorName == myName()
          && request.resource.data.createdAt == request.time
          && request.resource.data.detail is string
          && request.resource.data.detail.size() <= 2000
          && (
            (request.resource.data.type == 'observation'
              && exists(projectDoc(pid))
              && get(projectDoc(pid)).data.archived == false
              && request.resource.data.detail.size() > 0)
            ||
            (request.resource.data.type == 'created'
              && getAfter(projectDoc(pid)).data.lastActionId == eid
              && getAfter(projectDoc(pid)).data.createdAt == request.time
              && getAfter(projectDoc(pid)).data.authorId == request.auth.uid
              && request.resource.data.detail == '')
            ||
            (request.resource.data.type == 'review_started'
              && areaManagerRole()
              && getAfter(projectDoc(pid)).data.areaManagerId == request.auth.uid
              && getAfter(projectDoc(pid)).data.status == 'review'
              && getAfter(projectDoc(pid)).data.lastActionId == eid
              && getAfter(projectDoc(pid)).data.updatedAt == request.time)
            ||
            (request.resource.data.type == 'manager_approved'
              && manager()
              && request.resource.data.detail == ''
              && getAfter(projectDoc(pid)).data.approvalStates[request.auth.uid] == 'approved'
              && getAfter(projectDoc(pid)).data.lastActionId == eid
              && getAfter(projectDoc(pid)).data.updatedAt == request.time)
            ||
            (request.resource.data.type in ['rejected', 'in_progress', 'completed', 'not_completed', 'archived']
              && (request.resource.data.type == 'completed'
                ? getAfter(projectDoc(pid)).data.authorId == request.auth.uid
                : manager())
              && getAfter(projectDoc(pid)).data.lastActionId == eid
              && getAfter(projectDoc(pid)).data.updatedAt == request.time
              && ((request.resource.data.type == 'archived'
                  && getAfter(projectDoc(pid)).data.archived == true)
                || (request.resource.data.type != 'archived'
                  && getAfter(projectDoc(pid)).data.status == request.resource.data.type))
              && ((request.resource.data.type == 'not_completed'
                  && request.resource.data.detail == getAfter(projectDoc(pid)).data.nonCompletionReason)
                || (request.resource.data.type != 'not_completed'
                  && request.resource.data.detail == '')))
          );
        allow update, delete: if false;
      }
    }
  }
}
